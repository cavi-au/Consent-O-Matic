{
	"name": "Consent-O-Manual",
	"description": "One clear popup for every cookie banner: your choice, applied the way you decide",
	"author": "Consent-O-Manual team (based on Consent-O-Matic by CAVI - Aarhus University)",
	"homepage_url": "https://github.com/NoahBao/Consent-O-Matic-Plus",
	"version": "REPLACED_BY_BUILD_SCRIPT",
	"manifest_version": 3,
	"permissions": [
		"activeTab",
		"tabs",
		"storage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"action": {
		"default_title": "Consent-O-Manual",
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "service.js"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"content.js"
			],
			"css": [
				"content.css"
			],
			"all_frames": true,
			"match_about_blank": true,
			"run_at": "document_start"
		}
	],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"icons": {
		"16": "icon_16.png",
		"32": "icon_32.png",
		"48": "icon_48.png",
		"96": "icon_96.png",
		"128": "icon_128.png"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"logo.png"
			],
			"matches": [
				"<all_urls>"
			]
		}
	]
}
