{
  "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
  "sainsburys": {
    "detectors": [
      {
        "presentMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#onetrust-consent-sdk"
            }
          }
        ],
        "showingMatcher": [
          {
            "type": "css",
            "target": {
              "selector": "#onetrust-banner-sdk",
              "displayFilter": true
            }
          }
        ]
      }
    ],
    "methods": [
      {
        "name": "HIDE_CMP",
        "action": {
          "type": "hide",
          "target": {
            "selector": "#onetrust-consent-sdk"
          }
        }
      },
      {
        "name": "SAVE_CONSENT",
        "action": {
          "type": "ifcss",
          "target": {
            "selector": "#onetrust-reject-all-handler"
          },
          "trueAction": {
            "type": "click",
            "target": {
              "selector": "#onetrust-reject-all-handler"
            }
          },
          "falseAction": {
            "type": "click",
            "target": {
              "selector": "#onetrust-accept-btn-handler"
            }
          }
        }
      }
    ]
  }
}
