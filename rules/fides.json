                                "target": {
                                    "selector": "input.fides-toggle-input"
                                }
                            },
                            "toggleAction": {
                                "parent": {
                                    "selector": ".fides-notice-toggle",
                                    "textFilter": [
                                        "Use limited data to select advertising"
                                    ]
                                },
                                "target": {
                                    "selector": "input.fides-toggle-input"
                                },
                                "type": "click"
                            },
                            "type": "F"
                        },
                        {
                            "matcher": {
                                "type": "checkbox",
                                "parent": {
