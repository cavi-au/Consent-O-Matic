{
    "$schema": "https://raw.githubusercontent.com/cavi-au/Consent-O-Matic/master/rules.schema.json",
    "Facebook": {
        "detectors": [
            {
                "presentMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "div[role='dialog']",
                            "textFilter": [
                                "Autoriser l\u2019utilisation des cookies",
                                "Autoriser l'utilisation des cookies",
                                "Allow the use of cookies",
                                "Verwendung von Cookies",
                                "Uso de cookies",
                                "Utilizzo dei cookie"
                            ]
                        }
                    }
                ],
                "showingMatcher": [
                    {
                        "type": "css",
                        "target": {
                            "selector": "div[role='dialog']",
                            "textFilter": [
                                "Autoriser l\u2019utilisation des cookies",
                                "Autoriser l'utilisation des cookies",
                                "Allow the use of cookies",
                                "Verwendung von Cookies",
                                "Uso de cookies",
                                "Utilizzo dei cookie"
                            ],
                            "displayFilter": true
                        }
                    }
                ]
            }
        ],
        "methods": [
            {
                "name": "OPEN_OPTIONS"
            },
            {
                "name": "DO_CONSENT",
                "action": {
                    "type": "ifallowall",
                    "trueAction": {
                        "type": "click",
                        "target": {
                            "selector": "div[role='dialog'] div[role='button']",
                            "textFilter": [
                                "Autoriser tous les cookies",
                                "Allow all cookies",
                                "Alle Cookies erlauben",
                                "Permitir todas las cookies",
                                "Consenti tutti i cookie"
                            ]
                        }
                    },
                    "falseAction": {
                        "type": "click",
                        "target": {
                            "selector": "div[role='dialog'] div[role='button']",
                            "textFilter": [
                                "Refuser les cookies optionnels",
                                "Decline optional cookies",
                                "Optionale Cookies ablehnen",
                                "Rechazar cookies opcionales",
                                "Rifiuta i cookie facoltativi"
                            ]
                        }
                    }
                }
            },
            {
                "name": "SAVE_CONSENT"
            },
            {
                "name": "HIDE_CMP",
                "action": {
                    "type": "hide",
                    "target": {
                        "selector": "div[role='dialog']",
                        "textFilter": [
                            "Autoriser l\u2019utilisation des cookies",
                            "Autoriser l'utilisation des cookies",
                            "Allow the use of cookies",
                            "Verwendung von Cookies"
                        ]
                    }
                }
            },
            {
                "name": "UTILITY"
            }
        ]
    }
}
